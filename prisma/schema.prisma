generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  username         String?  @unique // required for ADMIN login only
  email            String?  @unique
  passwordHash     String?  // required for ADMIN login only
  name             String   @default("")
  role             String   @default("USER") // ADMIN | USER
  biometricPattern String?  // hashed keypad pattern; null => SET mode
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
