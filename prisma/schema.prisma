generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  username         String?  @unique // required for ADMIN login only
  email            String?  @unique
  passwordHash     String?  // required for ADMIN login only
  name             String   @default("")
  role             String   @default("USER") // ADMIN | USER
  /// Knock gap pattern in ms, e.g. "320,890,410,1200" — null => SET mode
  biometricPattern String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String   @default("")
  action    String   // LOOKUP | SET | GET
  result    String   // SUCCESS | FAIL | NOT_FOUND | ...
  detail    String   @default("")
  createdAt DateTime @default(now())
}
